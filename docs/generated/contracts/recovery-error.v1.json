{
  "additionalProperties": false,
  "description": "A sanitized recovery error; credentials and provider bodies never enter it.",
  "properties": {
    "code": {
      "enum": [
        "PROVIDER_TIMEOUT",
        "PROVIDER_HTTP_429",
        "PROVIDER_HTTP_5XX",
        "UNKNOWN_PROVIDER_OUTCOME",
        "PROVIDER_AUTH_REQUIRED",
        "PROVIDER_PERMISSION_DENIED",
        "INVALID_PAYLOAD",
        "RECEIPT_MISMATCH"
      ],
      "title": "Code",
      "type": "string"
    },
    "sanitized_detail": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Sanitized Detail",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "code",
    "sanitized_detail"
  ],
  "title": "RecoveryError",
  "type": "object"
}
